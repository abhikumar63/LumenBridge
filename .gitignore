# ==========================================
# LumenBridge: Hybrid Python/C++/CUDA Engine
# ==========================================

# 1. Python Runtime & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# 2. PyTorch C++ Build Artifacts (Crucial)
# Blocks the temporary compiler files generated by setup.py
build/
dist/
*.egg-info/
pip-wheel-metadata/
.eggs/

# 3. Native Binaries & Shared Objects
# Blocks compiled C++/CUDA binaries (.so for Linux, .dylib for Mac)
*.o
*.so
*.dylib
*.a
*.dll

# 4. Deep Learning Weights & Graphs
# NEVER commit these heavy files to standard Git
*.pth
*.pt
*.onnx
*.engine
*.plan
fp32_model.pth
int8_model.pth
lumenbridge_stem.onnx

# 5. OS & IDE Configuration Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*.swo